:host{ all:initial; font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial; }
.fab{
  position: fixed; left: 18px; bottom: 18px; z-index: 1100;
  width: 64px; height: 64px; border-radius: 50%; border: 0; cursor: pointer;
  background: radial-gradient(circle at 30% 30%, #fff6, transparent 60%), linear-gradient(180deg,#ffd166,#ff9f1c);
  box-shadow: 0 18px 38px rgba(0,0,0,.4), inset 0 2px 4px #fff5; font-size: 26px;
}
.panel{
  position: fixed; left: 12px; top: 12px; bottom: 12px; width: 420px; max-width: calc(100vw - 24px);
  transform: translateX(-460px); transition: transform .28s ease; z-index: 1101;
  display: grid; grid-template-rows: auto 1fr auto; border-radius: 18px; overflow: hidden;
  background: rgba(9,18,32,.82); color: #e7f0ff; backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,.08); box-shadow: 0 28px 80px rgba(0,0,0,.55);
}
.panel.open{ transform: translateX(0) }
.head{ display:flex; align-items:center; justify-content:space-between; padding: 10px 12px; border-bottom: 1px solid rgba(255,255,255,.06);}
.left{ display:flex; align-items:center; gap:10px; }
.logo{ filter: drop-shadow(0 8px 18px rgba(255,215,0,.25)); }
.close{ background:transparent; border:0; color:#e7f0ff; font-size:20px; cursor:pointer; }
.list{ overflow:auto; padding: 14px 12px; }
.msg{ display:grid; grid-template-columns: 42px 1fr; gap: 12px; margin: 10px 0; }
.msg.user{ grid-template-columns: 1fr 42px; }
.msg.user .avatar{ order:2 } .msg.user .bubble{ order:1; background:#155e59 }
.avatar{ width:42px; height:42px; display:grid; place-items:center; border-radius:50%; background:#0c2038; border:1px solid rgba(255,255,255,.08); }
.bubble{ border-radius:16px; padding:14px 16px; background:#13233a; border:1px solid rgba(255,255,255,.08); }
.links{ margin-top:8px; display:flex; flex-direction:column; gap:6px; }
.links a{ color:#9bd8ff; text-decoration:none; }
.links a:hover{ text-decoration:underline; }
.typing{ padding: 10px 12px; }
.typing i{ display:inline-block; width:8px; height:8px; margin-right:6px; border-radius:50%; background:#c7d2fe; animation: b 1.2s infinite ease-in-out; }
.typing i:nth-child(2){ animation-delay:.15s } .typing i:nth-child(3){ animation-delay:.3s }
@keyframes b{0%,80%,100%{opacity:.25}40%{opacity:1}}
.input{ display:flex; gap:10px; padding:10px 12px; border-top:1px solid rgba(255,255,255,.06); background: rgba(9,19,33,.6);}
.input input{ flex:1; height:44px; border-radius:12px; border:1px solid rgba(255,255,255,.12); background:#0b1727; color:#fff; padding:0 12px; }
.send{ width:46px; height:46px; border-radius:12px; border:0; background:linear-gradient(90deg,#22d3ee,#60a5fa); color:#06111c; font-weight:800; cursor:pointer; }
@media (max-width:520px){ .panel{ left:10px; right:10px; width:auto } }
